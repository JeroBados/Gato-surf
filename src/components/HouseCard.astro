---
import type { House, Lang } from '../data/houses';
import { routes, t } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { house: House; lang: Lang }
const { house, lang } = Astro.props;
const s = t(lang);
---
<a class="gs-house" href={routes.house[lang](house.slug)}>
  <div class="gs-photo gs-photo--4x5">
    <img src={house.card} alt={house.gallery[0].alt[lang]} width="900" height="1125" loading="lazy" decoding="async" />
  </div>
  <div class="gs-house__body">
    <p class="gs-eyebrow">N.º {house.number}</p>
    <h3 class="gs-house__name">{house.name}</h3>
    <p class="gs-house__meta">{s.houseMeta(house.bedrooms, house.baths, house.guests)}</p>
    <div class="gs-house__foot"><span>{s.cota}</span><Icon name="arrow" /></div>
  </div>
</a>
