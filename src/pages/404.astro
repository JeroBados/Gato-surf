---
import Base from "../layouts/Base.astro";
---
<Base lang="en" title="Page not found · Gato Surf Houses" description="This page does not exist." alt={{ en: "/", es: "/es/" }} noindex>
  <div class="gs-wrap gs-section">
    <p class="gs-eyebrow">404</p>
    <h1 class="gs-display-l" style="margin-block:var(--space-4) var(--space-6)">This page drifted out to sea.</h1>
    <p class="gs-lead" style="margin-bottom:var(--space-8)">Esta página no existe. The houses are still twenty meters from the point.</p>
    <a class="gs-btn gs-btn--primary" href="/">Back to the houses</a>
  </div>
</Base>
